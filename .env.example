# Convex
# Convex deployment name (e.g. "happy-animal-123")
CONVEX_DEPLOYMENT=
# Convex deployment URL ending in .convex.cloud
VITE_CONVEX_URL=
# Convex site URL ending in .convex.site (used for Better Auth proxy)
CONVEX_SITE_URL=

# Better Auth
# Random secret, at least 32 chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full URL where the app is hosted (e.g. https://lake-house.example.com)
BETTER_AUTH_URL=

# Sentry
VITE_SENTRY_DSN=
# Set to "development", "staging", or "production"
SENTRY_ENVIRONMENT=development
# Optional: Sentry auth token for source map uploads in CI
SENTRY_AUTH_TOKEN=

# Email provider for magic links (add your provider's credentials)
# Example for Resend:
# RESEND_API_KEY=
