# Convex
# Convex deployment name (e.g. "happy-animal-123")
CONVEX_DEPLOYMENT=
# Convex deployment URL ending in .convex.cloud
VITE_CONVEX_URL=
# Convex site URL ending in .convex.site (used by auth.config.ts as JWT domain)
CONVEX_SITE_URL=

# Convex Auth environment variables (set these in the Convex dashboard or via CLI):
#   JWKS_PRIVATE_KEY  — generated by: npx @convex-dev/auth
#   SITE_URL          — your app URL (e.g. http://localhost:3000)
#   AUTH_RESEND_KEY   — Resend API key for magic link emails
#   AUTH_EMAIL_FROM   — Sender address (e.g. "Lake House <noreply@chatsumlin.com>")

# Sentry
VITE_SENTRY_DSN=
# Set to "development", "staging", or "production"
SENTRY_ENVIRONMENT=development
# Optional: Sentry auth token for source map uploads in CI
SENTRY_AUTH_TOKEN=
